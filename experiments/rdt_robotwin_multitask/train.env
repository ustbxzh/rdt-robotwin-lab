# Local shared-policy adaptation schedule for the four-task ARX-X5 dataset.
export RDT_DATASET_NAME=robotwin_arx_x5_multitask
export RDT_MAX_TRAIN_STEPS=10000
export RDT_CHECKPOINTING_PERIOD=2000
export RDT_TRAIN_BATCH_SIZE=8
export RDT_GRADIENT_ACCUMULATION_STEPS=4
export RDT_SAMPLE_BATCH_SIZE=16
export RDT_SAMPLE_PERIOD=1000
export RDT_CHECKPOINTS_TOTAL_LIMIT=6
export RDT_LR_SCHEDULER=constant
export RDT_LEARNING_RATE=1e-4
export RDT_MIXED_PRECISION=bf16
export RDT_DATALOADER_NUM_WORKERS=8
export RDT_STATE_NOISE_SNR=40
export RDT_PRECOMP_LANG_EMBED=1
export RDT_REPORT_TO=wandb
